# CDBS.OS — copie para .env (cp config/.env.example .env) e preencha só o que for usar.
# NUNCA coloque este arquivo preenchido num ZIP, num print ou numa conversa: ele pode ter tokens.

# Portas locais (não mude sem necessidade). O túnel vai SÓ para a porta dos sites; o painel nunca é exposto.
CDBS_SITE_PORT=8088
CDBS_ADMIN_PORT=8089

# Endereço HTTPS fixo (quando usar um túnel nomeado com domínio próprio). Vazio = usa o link temporário do túnel.
# Exemplo: CDBS_PUBLIC_BASE=https://sites.seudominio.com.br
CDBS_PUBLIC_BASE=

# ---- Monitoramento das 10 posições (também configurável pelo painel; o que estiver aqui vence o painel)
# CDBS_MONITOR_ENABLED=true
# CDBS_MONITOR_INTERVAL_MINUTES=30
# CDBS_MONITOR_PUBLIC_CHECK=false

# ---- WhatsApp (API oficial: WhatsApp Business Platform / Cloud API). Veja docs/WHATSAPP.md.
# Os valores secretos também podem ser salvos pelo painel (Notificações → Credenciais), sem editar este arquivo.
# CDBS_WHATSAPP_ENABLED=false
# CDBS_WHATSAPP_PHONE_NUMBER_ID=
# CDBS_WHATSAPP_ACCESS_TOKEN=
# CDBS_WHATSAPP_APP_SECRET=
# CDBS_WHATSAPP_VERIFY_TOKEN=
# CDBS_WHATSAPP_RECIPIENT=+55 85 90000-0000
# CDBS_WHATSAPP_TEMPLATE_REPORT=cdbs_relatorio_sites
# Variáveis do modelo do relatório: 12 (modelo completo) ou 3 (modelo resumido) — igual ao modelo aprovado na Meta.
# CDBS_WHATSAPP_REPORT_VARIABLES=12
# CDBS_WHATSAPP_TEMPLATE_ALERT=cdbs_alerta_site
# CDBS_WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
# CDBS_WHATSAPP_API_VERSION=v26.0

# ---- Avisos por e-mail (SMTP). Também pelo painel (Notificações → E-mail). Veja docs/EMAIL.md.
# No Gmail use uma SENHA DE APP (precisa da verificação em duas etapas), não a senha normal.
# CDBS_EMAIL_ENABLED=false
# CDBS_SMTP_HOST=smtp.gmail.com
# CDBS_SMTP_PORT=465
# CDBS_SMTP_SECURITY=ssl
# CDBS_SMTP_USER=
# CDBS_SMTP_PASSWORD=
# CDBS_EMAIL_TO=

# ---- Bot de comandos (!Link, !Status...). Números separados por vírgula, no formato internacional.
# CDBS_BOT_ENABLED=false
# CDBS_BOT_ADMINS=
# CDBS_BOT_VIEWERS=
# Listas e botões do WhatsApp no menu (false = menu só em texto numerado).
# CDBS_BOT_INTERACTIVE=true

# ---- Túnel gerenciado pelo supervisor: quick (link temporário), named (endereço fixo, precisa de token) ou off.
# CDBS_TUNNEL_MODE=quick
# CDBS_TUNNEL_AUTOSTART=false
# CDBS_TUNNEL_TOKEN=
# CDBS_TUNNEL_METRICS_PORT=20241

# --- Servidores (apps), desde a 4.0 ---
# As 5 vagas de servidor usam portas só no celular (127.0.0.1): esta e as 4 seguintes (padrão 8101 a 8105).
# CDBS_APP_PORT_BASE=8101
# Caminho do Node.js, se ele não estiver no PATH (no Termux: pkg install nodejs -y).
# CDBS_NODE_BIN=/data/data/com.termux/files/usr/bin/node
